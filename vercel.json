{
  "buildCommand": "node scripts/vercel-static-build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/home", "destination": "/index.html" },
    { "source": "/week", "destination": "/index.html" },
    { "source": "/schedule", "destination": "/index.html" },
    { "source": "/transit", "destination": "/index.html" },
    { "source": "/school", "destination": "/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/university", "destination": "/university/index.html" },
    { "source": "/university/timetable", "destination": "/university/index.html" },
    { "source": "/university/campus", "destination": "/university/index.html" },
    { "source": "/university/school", "destination": "/university/index.html" }
  ]
}